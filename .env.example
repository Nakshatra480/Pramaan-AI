# Pramaan AI — frontend (Vite + React). Copy to .env.local. Only VITE_* values
# reach the browser; they are public Firebase client config, not secrets.
# Backend settings (including DATABASE_URL — backend only, never VITE_*) live in backend/.env.example.

# "api" = Firebase + FastAPI backend, "mock" = in-browser demo data.
# If unset: "api" when VITE_API_URL and Firebase config are both present.
VITE_DATA_SOURCE=
VITE_API_URL=http://localhost:8000
VITE_APP_URL=http://localhost:3000

# Firebase client configuration — project pramaan-ai-prod, "Default Web App".
# Get the values with:  firebase apps:sdkconfig WEB --project pramaan-ai-prod
# (Firebase web config is public by design; access is enforced by the backend.)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=pramaan-ai-prod
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional
VITE_FIREBASE_MEASUREMENT_ID=          # Analytics (4 product events, no research content)
VITE_FIREBASE_APPCHECK_SITE_KEY=       # App Check (reCAPTCHA v3 site key)
# Local Auth Emulator — development only (`npm run dev:emulator`). Production builds refuse it.
VITE_FIREBASE_USE_EMULATOR=false
# VITE_FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099   # default when the emulator is enabled
