# Pramaan AI — frontend (Next.js). Copy to .env.local. Only NEXT_PUBLIC_* values
# reach the browser; they are public Firebase client config, not secrets.
# Backend settings (including DATABASE_URL — backend only, never NEXT_PUBLIC_*) live in backend/.env.example.

# "api" = Firebase + FastAPI backend, "mock" = in-browser demo data.
# If unset: "api" when NEXT_PUBLIC_API_URL and Firebase config are both present.
NEXT_PUBLIC_DATA_SOURCE=
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Firebase client configuration — project pramaan-ai-prod, "Default Web App".
# Get the values with:  firebase apps:sdkconfig WEB --project pramaan-ai-prod
# (Firebase web config is public by design; access is enforced by the backend.)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=pramaan-ai-prod
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Optional
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=          # Analytics (4 product events, no research content)
NEXT_PUBLIC_FIREBASE_APPCHECK_SITE_KEY=       # App Check (reCAPTCHA v3 site key)
# Local Auth Emulator — development only (`npm run dev:emulator`). Production builds refuse it.
NEXT_PUBLIC_FIREBASE_USE_EMULATOR=false
# NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099   # default when the emulator is enabled
