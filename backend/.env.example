# Pramaan AI backend configuration. Copy to .env for local development.
# Never commit real values. In production, set these as Render environment variables / secrets.

ENVIRONMENT=development          # development | test | production
LOG_LEVEL=INFO

# Database — backend only; never put this in NEXT_PUBLIC_* variables.
# Local: Homebrew Postgres + pgvector (see README.md §11) or a Neon development branch.
DATABASE_URL=postgresql+asyncpg://localhost:5432/pramaan
# Neon (production): paste the POOLED connection string exactly as Neon gives it
# (postgresql://…-pooler….neon.tech/neondb?sslmode=require&channel_binding=require);
# it is normalised for asyncpg automatically. Production refuses localhost or non-TLS URLs.
# Optional: DIRECT (non-pooler) Neon URL used only by Alembic for DDL.
MIGRATIONS_DATABASE_URL=
DB_POOL_SIZE=5
DB_POOL_RECYCLE_S=300

# Comma-separated. Production: your Vercel domain only. Wildcards are refused.
CORS_ORIGINS=http://localhost:3000

# Firebase ID token verification. Only the project id is required: tokens are
# verified against Google's public signing keys (no service-account key needed).
FIREBASE_PROJECT_ID=pramaan-ai-prod
# Optional — revocation checks / App Check call Admin APIs and need credentials. Never commit keys.
FIREBASE_CHECK_REVOKED=false
FIREBASE_APP_CHECK_REQUIRED=false
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Local Auth Emulator (development only — production startup refuses it):
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# Research providers (server-side only)
TAVILY_API_KEY=                  # web search is skipped when empty
OPENALEX_MAILTO=                 # optional: OpenAlex "polite pool"
RESEARCH_TIMEOUT_S=600

# Text generation — Groq (fake = tests/offline only: extractive reports; refused in production).
LLM_PROVIDER=groq                # (legacy alias: MODEL_PROVIDER)
GROQ_API_KEY=                    # https://console.groq.com/keys (secret)
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TIMEOUT_S=60

# Embeddings — OpenRouter (fake = tests/offline only; refused in production).
# The model must accept dimensions=768. Changing the model requires re-indexing every document.
EMBEDDING_PROVIDER=openrouter
OPENROUTER_API_KEY=              # https://openrouter.ai/settings/keys (secret)
EMBEDDING_MODEL=nvidia/nemotron-3.5-embed-8b:free
EMBEDDING_DIM=768                # must match the migration — do not change
EMBEDDING_BATCH_SIZE=128         # texts per request (fewer requests against free-tier limits)

# Redis (optional). Empty = disabled: rate limits stay in-process, no caches, progress streams poll the database.
# Production: a TLS URL (rediss://…), e.g. from Upstash.
REDIS_URL=
CACHE_TTL_SEARCH_S=86400         # Tavily / OpenAlex results
CACHE_TTL_EMBED_S=604800         # question embeddings

# Jobs (stored in Postgres; see README.md §3)
RESEARCH_CONCURRENCY=1
INDEXING_CONCURRENCY=1
JOB_LEASE_S=90
JOB_MAX_ATTEMPTS=2
WARMUP_ENABLED=true

# File storage. local = backend/.storage (development only; refused in production);
# s3 = any S3-compatible service — Supabase Storage in production (README.md §13).
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=./.storage
S3_ENDPOINT=                     # https://<project-ref>.supabase.co/storage/v1/s3
S3_REGION=                       # the Supabase project's region, e.g. ap-south-1
S3_BUCKET=                       # a PRIVATE bucket
S3_ACCESS_KEY_ID=                # Storage → Settings → S3 access keys (secret)
S3_SECRET_ACCESS_KEY=            # (secret)
MAX_UPLOAD_BYTES=20971520

# Observability (optional) — enables LangSmith tracing of the research graph
LANGSMITH_API_KEY=

RATE_LIMIT_PER_MINUTE=600
