# Generated from vercel.json by `npm run caddyfile` (src/lib/hosting.ts). Do not edit by hand.
# Serves the built web app from /srv/www and proxies the API (same origin) to the api container.
{$SITE_ADDRESS} {
	encode zstd gzip

	header {
		Content-Security-Policy "frame-ancestors 'none'; object-src 'none'; base-uri 'self'"
		X-Frame-Options "DENY"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(self), geolocation=(), payment=(), usb=()"
		Cross-Origin-Opener-Policy "same-origin-allow-popups"
		Strict-Transport-Security "max-age=31536000"
		-Server
	}

	# API: REST, the research progress stream (SSE, unbuffered) and health checks.
	@api path /api/* /health /health/* /ready
	handle @api {
		reverse_proxy api:8000 {
			flush_interval -1
		}
	}

	# Web app: client routes get index.html; anything that isn't a file is a real 404.
	@app path_regexp app `^(?:\/|\/pricing\/?|\/privacy\/?|\/security\/?|\/how-it-works\/?|\/onboarding\/?|\/app\/?|\/history\/?|\/auth(?:\/.*)?\/?|\/shared\/[^/]+\/?|\/research(?:\/.*)?\/?|\/library(?:\/.*)?\/?|\/projects(?:\/.*)?\/?|\/settings(?:\/.*)?\/?)$`
	handle {
		root * /srv/www
		route {
			header /assets/* Cache-Control "public, max-age=31536000, immutable"
			rewrite @app /index.html
			header /index.html Cache-Control "no-cache"
			file_server
		}
	}

	handle_errors {
		@notFound expression {err.status_code} == 404
		handle @notFound {
			root * /srv/www
			rewrite * /404.html
			header Cache-Control "no-cache"
			file_server
		}
		handle {
			respond "{err.status_code} {err.status_text}" {err.status_code}
		}
	}
}
